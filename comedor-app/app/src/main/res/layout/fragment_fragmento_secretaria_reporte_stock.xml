<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragmento_secretaria.fragmento_secretaria_reporte_stock">

    <TextView
        android:id="@+id/textView17"
        android:layout_width="414dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="0dp"
        android:background="#7FD5C5"
        android:gravity="center_horizontal"
        android:text="Reporte stock becados"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/textView23"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="    Perido          Cantidad    Accion" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="match_parent">




            <ListView
                android:id="@+id/lista_stock_periodo"
                android:layout_width="90dp"
                android:layout_marginTop="70dp"
                android:layout_height="296dp" />

            <ListView
                android:id="@+id/lista_stock_becados"
                android:layout_width="50dp"
                android:layout_marginTop="70dp"
                android:layout_height="296dp" />
            <ListView
                android:id="@+id/lista_editar"
                android:layout_width="90dp"
                android:layout_marginTop="70dp"
                android:layout_height="296dp" />
            <ListView
                android:id="@+id/lista_eliminar"
                android:layout_width="110dp"
                android:layout_marginTop="70dp"
                android:layout_height="296dp" />


        </LinearLayout>

    </ScrollView>





</FrameLayout>
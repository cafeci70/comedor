<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragmento_alumno.fragmento_alumno_reporte_almuerzo">

    <TextView
        android:id="@+id/textView17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#7FD5C5"
        android:gravity="center_horizontal"
        android:paddingVertical="8dp"
        android:text="Ticket de almuerzo"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="@dimen/header_text_size" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/screen_padding_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_nombre_"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="N° Ticket :"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/r_numero_ticket"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Null"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_apellido_"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Fecha :"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/body_text_size" />

                    <TextView
                        android:id="@+id/r_fecha_ticket"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Null"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_direccion_"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Alumno :"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/body_text_size" />

                    <TextView
                        android:id="@+id/r_nombre_alumno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Null"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_celular_"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Menu :"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/body_text_size" />

                    <TextView
                        android:id="@+id/r_menu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Null"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/img_qr"
                    android:layout_width="@dimen/qr_image_size"
                    android:layout_height="@dimen/qr_image_size"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Código QR del ticket"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher_background" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</LinearLayout>

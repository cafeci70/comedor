<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragmento_alumno.fragmento_alumno_menu">

    <TextView
        android:id="@+id/textView17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#7FD5C5"
        android:gravity="center_horizontal"
        android:paddingVertical="8dp"
        android:text="Reporte menu"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="@dimen/header_text_size" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E6F5F2"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="115dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="Fecha"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="Desayuno"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="Almuerzo-entrada"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="Almuerzo-postre"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="Almuerzo"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="Almuerzo-bebida"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="Cena-entrada"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="Cena-postre"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="Cena"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="Cena-bebida"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ListView
                    android:id="@+id/lista_menu_fecha"
                    android:layout_width="115dp"
                    android:layout_height="match_parent" />

                <ListView
                    android:id="@+id/lista_menu_desayuno"
                    android:layout_width="220dp"
                    android:layout_height="match_parent" />

                <ListView
                    android:id="@+id/lista_menu_alm_entrada"
                    android:layout_width="170dp"
                    android:layout_height="match_parent" />

                <ListView
                    android:id="@+id/lista_menu_alm_postre"
                    android:layout_width="150dp"
                    android:layout_height="match_parent" />

                <ListView
                    android:id="@+id/lista_menu_almuerzo"
                    android:layout_width="180dp"
                    android:layout_height="match_parent" />

                <ListView
                    android:id="@+id/lista_menu_alm_bebida"
                    android:layout_width="160dp"
                    android:layout_height="match_parent" />

                <ListView
                    android:id="@+id/lista_menu_cen_entrada"
                    android:layout_width="170dp"
                    android:layout_height="match_parent" />

                <ListView
                    android:id="@+id/lista_menu_cen_postre"
                    android:layout_width="150dp"
                    android:layout_height="match_parent" />

                <ListView
                    android:id="@+id/lista_menu_cena"
                    android:layout_width="200dp"
                    android:layout_height="match_parent" />

                <ListView
                    android:id="@+id/lista_menu_cen_bebida"
                    android:layout_width="160dp"
                    android:layout_height="match_parent" />

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>

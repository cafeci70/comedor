<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgScreen"
    android:orientation="vertical"
    tools:context=".fragmento_alumno.fragmento_alumno_reporte_cena">

    <TextView
        android:id="@+id/textView17"
        style="@style/ComedorSectionHeader"
        android:text="Ticket de cena" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/screen_padding_vertical">

            <LinearLayout
                style="@style/ComedorCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_nombre_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="N° Ticket"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/r_numero_ticket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_soft"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="---"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_apellido_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Fecha"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/r_fecha_ticket"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="---"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_direccion_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Alumno"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/r_nombre_alumno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="---"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_celular_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Menú"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/r_menu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="4dp"
                        android:text="---"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_qr_frame"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/img_qr"
                        android:layout_width="@dimen/qr_image_size"
                        android:layout_height="@dimen/qr_image_size"
                        android:adjustViewBounds="true"
                        android:contentDescription="Código QR del ticket"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_launcher_background" />

                </FrameLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgScreen"
    android:orientation="vertical"
    tools:context=".fragmento_secretaria.fragmento_secretaria_perfil">

    <TextView
        android:id="@+id/textView17"
        style="@style/ComedorSectionHeader"
        android:text="Mis datos" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/screen_padding_vertical">

            <LinearLayout
                style="@style/ComedorCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_nombre_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Nombre"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/s_nombre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nombre"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_apellido_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Apellido"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/s_apellido"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Apellido"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_direccion_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Dirección"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/s_direccion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dirección"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_celular_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Celular"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/s_celular"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Celular"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/s_correo_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Correo"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/s_correo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Correo"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</LinearLayout>

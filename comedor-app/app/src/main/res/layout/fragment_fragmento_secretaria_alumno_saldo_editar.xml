<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgScreen"
    android:orientation="vertical"
    tools:context=".fragmento_secretaria.fragmento_secretaria_alumno_saldo_editar">

    <TextView
        android:id="@+id/textView17"
        style="@style/ComedorSectionHeader"
        android:text="Editar Saldo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/screen_padding_vertical">

            <LinearLayout
                style="@style/ComedorCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <TextView
                    android:id="@+id/textView12"
                    style="@style/ComedorFieldLabel"
                    android:text="Código de alumno" />

                <EditText
                    android:id="@+id/alum_codigo"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:enabled="false"
                    android:inputType="number"
                    android:maxLength="10" />

                <TextView
                    android:id="@+id/textView13"
                    style="@style/ComedorFieldLabel"
                    android:layout_marginTop="@dimen/form_section_spacing"
                    android:text="Nuevo saldo (S/.)" />

                <EditText
                    android:id="@+id/alum_saldo"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:hint="Ej. 15"
                    android:inputType="number"
                    android:maxLength="3" />

                <Button
                    android:id="@+id/btn_recargar"
                    style="@style/ComedorButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Guardar saldo" />

                <Button
                    android:id="@+id/btn_cancelar"
                    style="@style/ComedorButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cancelar" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgScreen"
    android:orientation="vertical"
    tools:context=".fragmento_secretaria.fragmento_secretaria_horario_editar">

    <TextView
        android:id="@+id/textView17"
        style="@style/ComedorSectionHeader"
        android:text="Editar Menú" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/screen_padding_vertical">

            <LinearLayout
                style="@style/ComedorCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <CalendarView
                    android:id="@+id/calendario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" />

                <View style="@style/ComedorDivider" />

                <TextView
                    android:id="@+id/textView24"
                    style="@style/ComedorFieldLabel"
                    android:layout_marginTop="8dp"
                    android:text="Desayuno" />

                <EditText
                    android:id="@+id/text_desayuno"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:inputType="textPersonName" />

                <TextView
                    android:id="@+id/textView25"
                    style="@style/ComedorFieldLabel"
                    android:layout_marginTop="@dimen/form_section_spacing"
                    android:text="Almuerzo — Entrada" />

                <EditText
                    android:id="@+id/text_al_entrada"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:inputType="textPersonName" />

                <TextView
                    android:id="@+id/textView26"
                    style="@style/ComedorFieldLabel"
                    android:layout_marginTop="@dimen/form_section_spacing"
                    android:text="Almuerzo — Postre" />

                <EditText
                    android:id="@+id/text_al_postre"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:inputType="textPersonName" />

                <TextView
                    android:id="@+id/textView27"
                    style="@style/ComedorFieldLabel"
                    android:layout_marginTop="@dimen/form_section_spacing"
                    android:text="Almuerzo — Plato principal" />

                <EditText
                    android:id="@+id/text_al"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:inputType="textPersonName" />

                <TextView
                    android:id="@+id/textView28"
                    style="@style/ComedorFieldLabel"
                    android:layout_marginTop="@dimen/form_section_spacing"
                    android:text="Almuerzo — Bebida" />

                <EditText
                    android:id="@+id/text_al_bebida"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:inputType="textPersonName" />

                <View style="@style/ComedorDivider" />

                <TextView
                    android:id="@+id/textView29"
                    style="@style/ComedorFieldLabel"
                    android:layout_marginTop="8dp"
                    android:text="Cena — Entrada" />

                <EditText
                    android:id="@+id/text_ce_entrada"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:inputType="textPersonName" />

                <TextView
                    android:id="@+id/textView30"
                    style="@style/ComedorFieldLabel"
                    android:layout_marginTop="@dimen/form_section_spacing"
                    android:text="Cena — Postre" />

                <EditText
                    android:id="@+id/text_ce_postre"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:inputType="textPersonName" />

                <TextView
                    android:id="@+id/textView31"
                    style="@style/ComedorFieldLabel"
                    android:layout_marginTop="@dimen/form_section_spacing"
                    android:text="Cena — Plato principal" />

                <EditText
                    android:id="@+id/text_ce"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:inputType="textPersonName" />

                <TextView
                    android:id="@+id/textView32"
                    style="@style/ComedorFieldLabel"
                    android:layout_marginTop="@dimen/form_section_spacing"
                    android:text="Cena — Bebida" />

                <EditText
                    android:id="@+id/text_ce_bebida"
                    style="@style/ComedorInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:inputType="textPersonName" />

                <Button
                    android:id="@+id/btn_registrar"
                    style="@style/ComedorButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Guardar cambios" />

                <Button
                    android:id="@+id/btn_cancelar"
                    style="@style/ComedorButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cancelar" />

                <TextView
                    android:id="@+id/textView33"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</LinearLayout>

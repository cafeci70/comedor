<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgScreen"
    android:orientation="vertical"
    tools:context=".fragmento_alumno.fragmento_alumno_perfil">

    <TextView
        android:id="@+id/textView17"
        style="@style/ComedorSectionHeader"
        android:text="Mis datos" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/screen_padding_vertical">

            <LinearLayout
                style="@style/ComedorCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/a_nombre_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Nombre"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/a_nombre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nombre_alumno"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/a_apellido_p_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Apellido P."
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/a_apellido_p"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Apellido_paterno"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/a_apellido_m_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Apellido M."
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/a_apellido_m"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Apellido_materno"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/a_correo_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Correo"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/a_correo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Correo_electronico"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/a_celular_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Celular"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/a_celular"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="N° Cel/Telf"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/a_saldo_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Saldo (S/.)"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/a_saldo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textColor="@color/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View style="@style/ComedorDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/a_beca_"
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Becado"
                        android:textColor="@color/textSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/a_beca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_soft"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="no"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</LinearLayout>

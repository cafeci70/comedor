<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragmento_secretaria.fragmento_secretaria_reporte_horario">

    <TextView
        android:id="@+id/textView17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="0dp"
        android:background="#7FD5C5"
        android:gravity="center_horizontal"
        android:text="Reporte menu"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="28sp" />


    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical" >
            <TextView
                android:id="@+id/textView23"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="    Fecha                      Desayuno                                                                    Almuerzo-entrada                          Almuerzo-postre                    Almuerzo                                        Almuerzo-bebida                         Cena-entrada                           Cena-postre                              Cena                                                                       Cena-bebida                          Accion"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ListView
                    android:id="@+id/lista_menu_fecha"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                    />

                <ListView
                    android:id="@+id/lista_menu_desayuno"
                    android:layout_width="300dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                     />

                <ListView
                    android:id="@+id/lista_menu_alm_entrada"
                    android:layout_width="200dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                    />

                <ListView
                    android:id="@+id/lista_menu_alm_postre"
                    android:layout_width="170dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                    />

                <ListView
                    android:id="@+id/lista_menu_almuerzo"
                    android:layout_width="200dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                   />

                <ListView
                    android:id="@+id/lista_menu_alm_bebida"
                    android:layout_width="190dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                     />

                <ListView
                    android:id="@+id/lista_menu_cen_entrada"
                    android:layout_width="180dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                     />

                <ListView
                    android:id="@+id/lista_menu_cen_postre"
                    android:layout_width="180dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                     />

                <ListView
                    android:id="@+id/lista_menu_cena"
                    android:layout_width="280dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                    />

                <ListView
                    android:id="@+id/lista_menu_cen_bebida"
                    android:layout_width="170dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                     />

                <ListView
                    android:id="@+id/lista_editar"
                    android:layout_width="130dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                   />

                <ListView
                    android:id="@+id/lista_eliminar"
                    android:layout_width="130dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                 />

            </LinearLayout>


        </LinearLayout>
    </HorizontalScrollView>

</FrameLayout>